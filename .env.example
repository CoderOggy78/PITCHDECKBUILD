# VentureForge AI Configuration

# Database (Postgres with pgvector or SQLite async)
DATABASE_URL=sqlite+aiosqlite:///data/ventureforge.db

# AI Provider Configuration ("deterministic", "gemini", "openai", "anthropic")
AI_PROVIDER=deterministic

# API Keys (Optional if running with deterministic local venture engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Next.js Web Frontend
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api
PORT=3000
